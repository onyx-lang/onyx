BinaryReader.read_i16_be :: (use br: &BinaryReader) -> Result(i16, Error) {
    buf: [2] u8;
    if err := read_exact(br, ~~buf); err != .None do return .{ Err = err };
    return .{ Ok = bytes.read_i16_be(~~buf) ?? 0 };
