BinaryReader.read_i32_le :: (use br: &BinaryReader) -> Result(i32, Error) {
    buf: [4] u8;
    if err := read_exact(br, ~~buf); err != .None do return .{ Err = err };
    return .{ Ok = bytes.read_i32_le(~~buf) ?? 0 };
