package core.os

use runtime

TTY_State :: struct {
    rows: i32;
    cols: i32;
    stdin_is_tty: bool;
    stdout_is_tty: bool;
    stderr_is_tty: bool;
    echo: bool;
    input_buffered: bool;
    input_linefeeds: bool;
}

tty_sane :: () {
    state := tty_get();
    state.echo = true;
    state.input_buffered = true;
    tty_set(&state);
}

tty_raw :: () {
    state := tty_get();
    state.echo = false;
    state.input_buffered = false;
    tty_set(&state);
}

#if runtime.platform.Supports_TTY {

tty_get :: () -> TTY_State {
    state: TTY_State;
    runtime.platform.__tty_get(&state);
    return state;
}

tty_set :: (state: &TTY_State) -> bool {
    return runtime.platform.__tty_set(state);
}

/// Saves the terminal mode and switches stdin to raw mode.
/// The host restores the saved mode on `tty_leave_raw` and on process exit.
tty_enter_raw :: () -> bool {
    return runtime.platform.__tty_enter_raw();
}

/// Restores the terminal mode saved by `tty_enter_raw`.
tty_leave_raw :: () -> bool {
    return runtime.platform.__tty_leave_raw();
}

} else {

tty_get :: () -> TTY_State {
    panic("core.os.tty_get not supported on this platform.");
}

tty_set :: (state: &TTY_State) -> bool {
    panic("core.os.tty_get not supported on this platform.");
    return false;
}

tty_enter_raw :: () -> bool {
    return false;
}

tty_leave_raw :: () -> bool {
    return false;
}

}


