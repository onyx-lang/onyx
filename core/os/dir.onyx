package core.os

#if !runtime.platform.Supports_Directories {
    #error "Cannot include this file. Platform not supported.";
}

use core.conv
use runtime

#local fs :: runtime.platform

Directory :: fs.DirectoryData;

DirectoryEntry :: struct {
    type        : FileType;
    identifier  : u32;
    name_length : u32;
    name_data   : [256] u8;
}

/// Returns the `str` of the name, pointing into the `DirectoryEntry` for data.
/// The string is valid for the lifetime of the `DirectoryEntry`.
DirectoryEntry.name :: (use dir: &DirectoryEntry) => str.{ ~~name_data, name_length };

/// Copies the name of the item into the provided allocator and returns it 
DirectoryEntry.name_copy :: (use dir: DirectoryEntry, allocator := context.allocator) =>
    str.copy(.{ ~~name_data, name_length }, allocator)

Directory.open :: (path: str) -> (Directory, bool) {
    dir: Directory;
    success := fs.__dir_open(path, &dir);
    return dir, success;
}

Directory.close :: (dir: Directory) {
    fs.__dir_close(dir);
}

Directory.read :: (dir: Directory, out_entry: &DirectoryEntry) -> bool {
    return fs.__dir_read(dir, out_entry);
}


Directory.create :: fs.__dir_create
Directory.exists :: fs.__file_exists
Directory.remove :: fs.__dir_remove
Directory.rename :: fs.__file_rename

/// Create `path` and any missing parents. Returns true if the directory
/// exists when this returns. Fails if a prefix exists and is not a directory.
Directory.create_all :: (path: str) -> bool {
    cleaned := Path.clean(path);
    if cleaned == "." || cleaned == "/" do return true;

    i := 0;
    if cleaned[0] == PATH_SEP do i = 1;

    while i <= cleaned.length {
        if i == cleaned.length || cleaned[i] == PATH_SEP {
            prefix := cleaned[0 .. i];
            if prefix.length > 0 {
                if Directory.exists(prefix) {
                    if !is_directory(prefix) do return false;
                } else {
                    if !Directory.create(prefix) do return false;
                }
            }
        }
        i += 1;
    }

    return true;
}

chdir  :: fs.__chdir
getcwd :: fs.__getcwd

Directory.list :: (path: str) -> Iterator(DirectoryEntry) {
    Context :: struct {
        dir: Directory;
        opened := false;
    }

    next :: (use c: &Context) -> ? DirectoryEntry {
        if !opened do return .None;

        entry: DirectoryEntry;
        if !Directory.read(dir, &entry) {
            return .None;
        }

        return entry;
    }

    close :: (use c: &Context) {
        if opened {
            Directory.close(dir);
        }

        cfree(c);
    }

    c := new(Context);
    if dir, success := Directory.open(path); success {
        c.dir = dir;
        c.opened = true;
    }

    return .{ c, next, close };
}

Directory.remove_recursive :: (path: str) -> bool {
    // This is quite a bit of space, and could result in a stack overrun
    // if the directory being deleted has a lot of descendents.
    full_path_buffer: [512] u8;

    for Directory.list(path) {
        full_path := conv.format(full_path_buffer, "{}{}{}", path, PATH_SEP, it->name());

        if it.type == .Directory {
            if !Directory.remove_recursive(full_path) do return false;
        } else {
            remove_file(full_path);
        }
    }

    return Directory.remove(path);    
}
