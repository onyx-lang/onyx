package core.os

use core {*}
use runtime.platform {
    __get_all_env,
    __get_env,
    __set_env,
    __unset_env
}

/// Snapshot of the process environment. Keys and values are copied; the caller owns them.
env_vars :: (allocator := context.allocator) -> Map(str, str) {
    m := make(Map(str, str), allocator);
    for p in __get_all_env() {
        m->put(str.copy(p.first, allocator), str.copy(p.second, allocator));
    }
    return m;
}

/// Looks up `key`. The returned string is a copy the caller owns.
env :: (key: str, allocator := context.allocator) -> ? str {
    v := __get_env(key);
    switch v {
        case .None do return .None;
        case .Some as s do return str.copy(s, allocator);
    }
}

setenv :: (key: str, value: str) -> bool {
    return __set_env(key, value);
}

unsetenv :: (key: str) -> bool {
    return __unset_env(key);
}
