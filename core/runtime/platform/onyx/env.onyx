package runtime.platform

use core {Pair, cstr}

__get_all_env :: () -> [] Pair(str, str) {
    env_count, env_buf_size: i32;
    __environ_sizes_get(&env_count, &env_buf_size);

    if env_count <= 0 do return .[];

    env_var := make([] cstr, env_count);
    env_buf := make([] u8, env_buf_size);
    __environ_get(env_var.data, env_buf.data);

    result := make([] Pair(str, str), env_count);
    for env, i in env_var {
        s := str.as_str(env);
        var, val := str.bisect(s, '=');
        result[i] = .{ var, val };
    }

    delete(&env_var);
    return result;
}

__get_env :: (key: str) -> ? str {
    #persist buf: [4096] u8;
    len := __lookup_env(key, buf);
    if len <= 0 do return .None;
    return buf[0 .. len];
}

#foreign "onyx_runtime" {
    __lookup_env :: (key: str, buf: str) -> i32 ---
    __set_env :: (key: str, value: str) -> bool ---
    __unset_env :: (key: str) -> bool ---
    __environ_sizes_get :: (count: &i32, buf_size: &i32) -> void ---
    __environ_get :: (ptrs: & &u8, buf: &u8) -> void ---
}
