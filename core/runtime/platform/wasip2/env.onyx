package runtime.platform

use core {*}
use wasi.cli.v0_2_12 {*}

#local {
    all_env: [] Pair(str, str);
    overlay: Map(str, str);
    deleted: Set(str);
    overlay_ready := false;
}

#local
ensure_overlay :: () {
    if overlay_ready do return;
    overlay = make(Map(str, str));
    deleted = make(Set(str));
    overlay_ready = true;
}

#local
load_env :: () {
    if all_env do return;

    vars := Environment.get_environment();
    result := make([..] Pair(str, str), vars.count);
    for item in vars {
        result << .{ str.copy(item.f0), str.copy(item.f1) };
        if item.f0.data do cfree(item.f0.data);
        if item.f1.data do cfree(item.f1.data);
    }
    if vars.data do cfree(vars.data);
    all_env = result;
}

__get_all_env :: () -> [] Pair(str, str) {
    load_env();
    if !overlay_ready do return all_env;

    result := make([..] Pair(str, str), 8);
    for p in all_env {
        if deleted->has(p.first) do continue;
        if overlay->has(p.first) {
            result << .{ p.first, overlay->get(p.first)! };
        } else {
            result << p;
        }
    }

    for key, value in overlay {
        found := false;
        for p in all_env {
            if p.first == key {
                found = true;
                break;
            }
        }
        if !found && !deleted->has(key) {
            result << .{ key, value };
        }
    }
    return result;
}

__get_env :: (key: str) -> ? str {
    if overlay_ready {
        if deleted->has(key) do return .None;
        if overlay->has(key) do return overlay->get(key);
    }

    load_env();
    for p in all_env {
        if p.first == key do return p.second;
    }
    return .None;
}

__set_env :: (key: str, value: str) -> bool {
    ensure_overlay();
    deleted->remove(key);
    overlay->put(str.copy(key), str.copy(value));
    return true;
}

__unset_env :: (key: str) -> bool {
    ensure_overlay();
    overlay->remove(key);
    deleted->insert(str.copy(key));
    return true;
}
