package runtime.platform

use wasi { environ_get, environ_sizes_get, Size }
use core {Pair, string, slice, Optional}

#local {
    all_env: [] Pair(str, str);
    overlay: Map(str, str);
    deleted: Set(str);
    overlay_ready := false;
}

#local
ensure_overlay :: () {
    if overlay_ready do return;
    overlay = make(Map(str, str));
    deleted = make(Set(str));
    overlay_ready = true;
}

#local
__lookup_all_envs :: () {
    if all_env do return;

    allocator := context.allocator;

    env_count, env_buf_size : Size;
    environ_sizes_get(&env_count, &env_buf_size);

    env_var := make([] cstr, env_count, allocator);
    env_buf := make([] u8, env_buf_size, allocator);

    environ_get(env_var.data, env_buf.data);

    // Fix pointers to be only 4 bytes wide
    while i := cast(i32) (env_var.count - 1); i >= 0 {
        defer i -= 1;
        env_var[i] = cast(cstr) (cast([&]u32) env_var.data)[i];
    }

    result := make([..] Pair(str, str), env_count, allocator);
    for env in env_var {
        s := string.from_cstr(env);
        var, val := string.bisect(s, '=');
        result << .{var, val};
    }

    delete(&env_var, allocator);

    all_env = result;
}

__get_all_env :: () -> [] Pair(str, str) {
    __lookup_all_envs();

    if !overlay_ready do return all_env;

    result := make([..] Pair(str, str), 8);
    for p in all_env {
        if deleted->has(p.first) do continue;
        if overlay->has(p.first) {
            result << .{ p.first, overlay->get(p.first)! };
        } else {
            result << p;
        }
    }

    for key, value in overlay {
        found := false;
        for p in all_env {
            if p.first == key {
                found = true;
                break;
            }
        }
        if !found && !deleted->has(key) {
            result << .{ key, value };
        }
    }

    return result;
}

__get_env :: (key: str) -> ? str {
    if overlay_ready {
        if deleted->has(key) do return .None;
        if overlay->has(key) do return overlay->get(key);
    }

    __lookup_all_envs();

    return slice.first(all_env, [v](v.first == key))
        |> Optional.from_ptr()
        |> Optional.transform(x => x.second);
}

__set_env :: (key: str, value: str) -> bool {
    ensure_overlay();
    deleted->remove(key);
    overlay->put(str.copy(key), str.copy(value));
    return true;
}

__unset_env :: (key: str) -> bool {
    ensure_overlay();
    overlay->remove(key);
    deleted->insert(str.copy(key));
    return true;
}
