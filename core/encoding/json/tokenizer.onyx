// Everything in this file is marked #package because I do not think
// that this code will be needed outside of this module. I do not see
// the value of having access to the tokenizer and parser of JSON directly.


package core.encoding.json
#allow_stale_code

use core.array
use core.io
use core.memory

#local
TOKENIZER_CHUNK :: 256

#package
Tokenizer :: struct {
    data: [] u8;
    reader: &io.Reader;
    buf: dyn_str;
    use position := Position.{ 0, 1, 1 };
}

#package
Token :: struct {
    Kind :: enum {
        Invalid;

        Open_Brace;    // {
        Close_Brace;   // }

        Open_Bracket;  // [
        Close_Bracket; // ]

        Comma;
        Colon;

        Null;
        True;
        False;

        Integer;
        Float;
        String;
    }

    kind: Kind = .Invalid;
    text: str  = null_str;
    use position := Position.{ 0, 1, 1 };
}

#package
Position :: struct {
    offset       : u32;  // Offset into the stream
    line, column : u32;  // Line and column number
}

#local
ensure :: (use tkn: ^Tokenizer, n: u32) -> bool {
    if reader == null {
        return offset + n <= data.count;
    }

    while true {
        if offset > data.count do return false;
        remaining := data.count - offset;
        if remaining >= n do return true;
        if !fill(tkn) do return false;
    }

    return false;
}

#local
fill :: (use tkn: ^Tokenizer) -> bool {
    if reader == null do return false;

    Array.ensure_capacity(&buf, buf.count + TOKENIZER_CHUNK);
    space := buf.capacity - buf.count;
    if space == 0 do return false;

    dest: [] u8;
    dest.data = buf.data + buf.count;
    dest.count = space;

    nread, _ := reader->read_bytes(dest);
    if nread <= 0 do return false;

    buf.count += cast(u32) nread;
    data = buf;
    return true;
}

#package
token_get :: (use tkn: ^Tokenizer) -> (Token, Error) {
    err := Error.{};

    skip_whitespace(tkn);
    token := Token.{};
    token.position = tkn.position;

    curr_char, has_next := next_character(tkn);
    if !has_next do return .{}, .{ .EOF, token.position };

    switch curr_char {
        case '{' do token.kind = .Open_Brace;
        case '}' do token.kind = .Close_Brace;
        case '[' do token.kind = .Open_Bracket;
        case ']' do token.kind = .Close_Bracket;
        case ',' do token.kind = .Comma;
        case ':' do token.kind = .Colon;

        case 'a' ..= 'z' {
            token.kind = .Invalid;
            skip_alpha_numeric(tkn);

            identifier := data.data[token.offset .. offset];
            if identifier == "null"  do token.kind = .Null;
            if identifier == "true"  do token.kind = .True;
            if identifier == "false" do token.kind = .False;
        }

        case '-' {
            ch, ok := peek_char(tkn);
            if !ok || ch < '0' || ch > '9' {
                err.kind = .Illegal_Character;
                err.pos  = token.position;
            } else {
                fallthrough;
            }
        }

        case '0' ..= '9' {
            token.kind = .Integer;
            skip_numeric(tkn);

            ch, ok := peek_char(tkn);
            if ok && ch == '.' {
                token.kind = .Float;
                next_character(tkn);
                skip_numeric(tkn);
                ch, ok = peek_char(tkn);
            }

            if ok && (ch == 'e' || ch == 'E') {
                next_character(tkn);
                sign, sok := peek_char(tkn);
                if sok && (sign == '-' || sign == '+') {
                    next_character(tkn);
                }
                skip_numeric(tkn);
            }
        }

        case '"' {
            token.kind = .String;
            closed := false;

            while true {
                ch, ok := peek_char(tkn);
                if !ok {
                    err.kind = .String_Unterminated;
                    err.pos  = token.position;
                    break;
                }

                if ch == '\n' {
                    err.kind = .String_Unterminated;
                    err.pos  = token.position;
                    break;
                }

                next_character(tkn);
                if ch == '"' {
                    closed = true;
                    break;
                }

                if ch == '\\' {
                    skip_escape(tkn);
                }
            }

            if !closed && err.kind == .None {
                err.kind = .String_Unterminated;
                err.pos  = token.position;
            }
        }
    }

    token.text = data.data[token.offset .. offset];

    if token.kind == .Invalid do err.kind = .Illegal_Character;

    return token, err;
}

#local
peek_char :: (use tkn: ^Tokenizer) -> (u8, bool) {
    if !ensure(tkn, 1) do return 0, false;
    return data[offset], true;
}

#local
next_character :: (use tkn: ^Tokenizer) -> (u8, bool) {
    if !ensure(tkn, 1) do return 0, false;

    retval := data[offset];
    offset += 1;
    column += 1;

    return retval, true;
}

#local
skip_whitespace :: (use tkn: ^Tokenizer) {
    while true {
        ch, ok := peek_char(tkn);
        if !ok do return;

        switch ch {
            case '\t', ' ', '\r', '\v' {
                next_character(tkn);
            }

            case '\n' {
                line += 1;
                column = 1;
                offset += 1;
            }

            case _ {
                return;
            }
        }
    }
}

#local
skip_alpha_numeric :: (use tkn: ^Tokenizer) {
    while true {
        ch, ok := peek_char(tkn);
        if !ok do return;

        switch ch {
            case 'A' ..= 'Z', 'a' ..= 'z', '0' ..= '9', '_' {
                next_character(tkn);
                continue;
            }
        }

        return;
    }
}

#local
skip_numeric :: (use tkn: ^Tokenizer) {
    while true {
        ch, ok := peek_char(tkn);
        if !ok do return;

        switch ch {
            case '0' ..= '9' {
                next_character(tkn);
                continue;
            }
        }

        return;
    }
}

#local
skip_escape :: (use tkn: ^Tokenizer) {
    ch, ok := peek_char(tkn);
    if !ok do return;

    switch ch {
        case 'u' {
            for i in 4 {
                _, more := next_character(tkn);
                if !more do return;
            }
        }

        case _ {
            next_character(tkn);
        }
    }
}
