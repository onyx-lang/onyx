package core.encoding.protobuf
#allow_stale_code

use core {Result, tprintf}
use core.memory
use core.misc
use runtime.info

#package {
    registered_proto_types: Map(type_expr, Proto_Message_Descriptor)
}

proto_types_preloaded :: #init () {
    registered_proto_types->init()
}

lookup_protobuf_descriptor :: (type: type_expr) -> ? Proto_Message_Descriptor {
    if desc := Map.get(&registered_proto_types, type); desc {
        return desc
    }

    struct_info := info.get_type_info(type)->as_struct()

    if struct_info.kind != .Struct || !Slice.some(struct_info.tags, [x](x.type == type_expr && *cast(&type_expr, x.data) == Message)) {
        return .None
    }

    fields := make([..] Proto_Field_Descriptor)

    for member in struct_info.members {
        type_info := member.type->info()
        switch type_info.kind {
            case .Union {
                u_info := type_info->as_union()
                if u_info.constructed_from == Optional {
                    desc: Proto_Field_Descriptor
                    desc.field_offset = member.offset
                    desc.field_type = u_info.variants[1].type
                    desc.field_size = desc.field_type->info().size
                    desc.is_optional = true
                    desc.optional_offset = ~~ type_info.alignment
                    apply_field_tag(member.tags, &desc)
                    fields->push(desc)
                } else {
                    tag_size: u16 = ~~ u_info.tag_enum->info().size
                    for variant in u_info.variants {
                        if variant.type == void do continue

                        desc: Proto_Field_Descriptor
                        desc.field_offset = member.offset
                        desc.field_type = variant.type
                        desc.field_size = ~~ variant.type->info().size
                        desc.is_oneof = true
                        desc.oneof_tag = variant.tag_value
                        desc.oneof_tag_size = tag_size
                        desc.optional_offset = ~~ type_info.alignment
                        desc.proto_field_number = ~~ variant.tag_value
                        if variant.type->info().kind == .Struct {
                            desc.proto_field_type = .MESSAGE
                        }
                        apply_field_tag(variant.tags, &desc)
                        fields->push(desc)
                    }
                }
            }

            case .Dynamic_Array {
                desc: Proto_Field_Descriptor
                desc.field_offset = member.offset
                desc.field_type = type_info->as_dynamic_array().of
                desc.field_size = desc.field_type->info().size
                desc.is_repeated = true
                apply_field_tag(member.tags, &desc)
                fields->push(desc)
            }

            case _ {
                desc: Proto_Field_Descriptor
                desc.field_offset = member.offset
                desc.field_size = type_info.size
                desc.field_type = member.type
                apply_field_tag(member.tags, &desc)
                fields->push(desc)
            }
        }
    }

    registered_proto_types->put(type, .{ fields = .{ fields.data, fields.count } })
    return registered_proto_types->get(type)
}

apply_field_tag :: (tags: [] any, dest: &Proto_Field_Descriptor) {
    tags
        |> .find_opt([x](x.type == Field))
        |> .transform(x => *misc.any_as(x, Field))
        |> .with([fi] {
            dest.proto_field_type   = ~~ fi.protobuf_type
            dest.proto_field_number = fi.number
        })
}


