package core.encoding.protobuf
#allow_stale_code

//
// Descriptor types
//

Proto_Message_Descriptor :: struct {
    fields: [] Proto_Field_Descriptor
    // proto_field_number -> fields index+1; 0 means missing
    by_number: [] i32
}

Proto_Field_Descriptor :: struct {
    is_optional:        bool
    is_repeated:        bool
    is_oneof:           bool
    optional_offset:    u16
    oneof_tag_size:     u16
    oneof_tag:          u32

    field_offset:       i32
    field_size:         i32
    field_type:         type_expr

    proto_field_type:   _Field_Type
    proto_field_number: i32
}


//
// Tag Types
//

Message :: #distinct void
Field   :: struct { number: i32; protobuf_type: u32 }


#package
_Encoding_Type :: enum {
    Varint :: 0
    I64    :: 1
    LEN    :: 2
    SGROUP :: 3
    EGROUP :: 4
    I32    :: 5
}

#package
_Field_Type :: enum {
    DOUBLE :: 1
    FLOAT :: 2
    INT64 :: 3
    UINT64 :: 4
    INT32 :: 5
    FIXED64 :: 6
    FIXED32 :: 7
    BOOL :: 8
    STRING :: 9
    GROUP :: 10
    MESSAGE :: 11
    BYTES :: 12
    UINT32 :: 13
    ENUM :: 14
    SFIXED32 :: 15
    SFIXED64 :: 16
    SINT32 :: 17
    SINT64 :: 18
}

write_union_tag :: (base: rawptr, tag: u32, size: u16) {
    switch size {
        case 1 do *cast(&u8)  base = ~~ tag
        case 2 do *cast(&u16) base = ~~ tag
        case 4 do *cast(&u32) base = tag
        case 8 do *cast(&u64) base = ~~ tag
        case _ {}
    }
}

read_union_tag :: (base: rawptr, size: u16) -> u32 {
    switch size {
        case 1 do return ~~ *cast(&u8)  base
        case 2 do return ~~ *cast(&u16) base
        case 4 do return *cast(&u32) base
        case 8 do return ~~ *cast(&u64) base
        case _ do return 0
    }
}
