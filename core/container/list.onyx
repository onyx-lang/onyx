package core.list

use core

ListElem :: struct (T: type_expr) {
    next: &ListElem(T) = null;
    prev: &ListElem(T) = null;
    data: T;
}

List :: struct (Elem_Type: type_expr) {
    allocator: Allocator;

    first: &ListElem(Elem_Type) = null;
    last:  &ListElem(Elem_Type) = null;
}

builtin.List :: List

/// Creates an empty list.
///
///     l := make(List(i32));
///     l->push_end(1);
///     delete(&l);
List.make :: ($T: type_expr, allocator := context.allocator) -> List(T) {
    return .{ allocator = allocator };
}

/// Prepares an existing list to use `allocator`. The list starts empty.
List.init :: (list: &List($T), allocator := context.allocator) {
    list.allocator = allocator;
    list.first = null;
    list.last = null;
}

List.free :: (list: &List) {
    elem := list.first;
    while elem != null {
        to_delete := elem;
        elem = elem.next;
        raw_free(list.allocator, to_delete);
    }

    list.first = null;
    list.last = null;
}

/// Frees the list. Prefer `delete(&list)`.
List.delete :: (list: &List) {
    List.free(list);
}

/// Removes every element so the list can be filled again.
List.clear :: (list: &List) {
    List.free(list);
}

/// Allocates a new list with the same elements.
List.copy :: (list: &List($T), allocator := context.allocator) -> List(T) {
    out := List.make(T, allocator);
    elem := list.first;
    while elem != null {
        List.push_end(&out, elem.data);
        elem = elem.next;
    }
    return out;
}

List.from_array :: (arr: [] $T, allocator := context.allocator) -> List(T) {
    l := List.make(T, allocator);
    for& arr {
        List.push_end(&l, *it);
    }
    return l;
}

#overload
__make_overload :: (_: &List($T), allocator := context.allocator) -> List(T) {
    return List.make(T, allocator);
}

#overload
builtin.delete :: List.delete

List.push_end :: (list: &List, x: list.Elem_Type) {
    new_elem := allocate_elem(list);
    new_elem.data = x;

    new_elem.prev = list.last;
    if list.last do list.last.next = new_elem;
    list.last = new_elem;

    if !list.first do list.first = new_elem;
}

List.push_begin :: (list: &List, x: list.Elem_Type) {
    new_elem := allocate_elem(list);
    new_elem.data = x;

    new_elem.next = list.first;
    if list.first do list.first.prev = new_elem;
    list.first = new_elem;

    if !list.last do list.last = new_elem;
}

List.pop_end :: (list: &List($T), default: T = .{}) -> T {
    if list.last == null do return default;

    end := list.last;
    list.last = list.last.prev;
    if list.last {
        list.last.next = null;
    } else {
        list.first = null;
    }

    defer raw_free(list.allocator, end);
    return end.data;
}

List.pop_begin :: (list: &List($T), default: T = .{}) -> T {
    if list.last == null do return default;

    begin := list.first;
    list.first = list.first.next;
    if list.first {
        list.first.prev = null;
    } else {
        list.last = null;
    }

    defer raw_free(list.allocator, begin);
    return begin.data;
}

List.pop_end_opt :: (list: &List($T)) -> ? T {
    if list.last == null do return .None;

    end := list.last;
    list.last = list.last.prev;
    if list.last {
        list.last.next = null;
    } else {
        list.first = null;
    }

    defer raw_free(list.allocator, end);
    return end.data;
}

List.pop_begin_opt :: (list: &List($T)) -> ? T {
    if list.last == null do return .None;

    begin := list.first;
    list.first = list.first.next;
    if list.first {
        list.first.prev = null;
    } else {
        list.last = null;
    }

    defer raw_free(list.allocator, begin);
    return begin.data;
}

List.empty :: (list: &List) -> bool {
    return list.first == null;
}

List.count :: (list: &List) -> i32 {
    c := 0;
    elem := list.first;
    while elem != null {
        c += 1;
        elem = elem.next;
    }

    return c;
}

List.at :: (list: &List($T), index: i32) -> &T {
    elem := list.first;
    while elem != null {
        if index == 0 do return &elem.data;
        index -= 1;
        elem = elem.next;
    }

    return null;
}

List.contains :: (list: &List, x: list.Elem_Type) -> bool {
    elem := list.first;
    while elem != null {
        if elem.data == x do return true;
        elem = elem.next;
    }

    return false;
}

List.fold :: (list: &List($T), init: $R, f: (T, R) -> R) -> R {
    val := init;

    link := list.first;
    while link != null {
        val = f(link.data, val);
        link = link.next;
    }

    return val;
}

List.map :: (list: &List($T), f: (T) -> $R) -> List(R) {
    new_list := List.make(R, allocator=list.allocator);
    elem := list.first;
    while elem != null {
        List.push_end(&new_list, f(elem.data));
        elem = elem.next;
    }

    return new_list;
}

List.as_iter :: (list: &List) =>
    core.iter.generator(&.{current = list.first}, (ctx) => {
        if ctx.current != null {
            defer ctx.current = ctx.current.next;
            return Optional.make(ctx.current.data);
        }

        return .None;
    });

#overload
core.iter.as_iter :: List.as_iter

#local allocate_elem :: macro (list: &List($T)) => new(ListElem(T), allocator=list.allocator);

// Compatibility: package names.
make           :: List.make
from_array     :: List.from_array
free           :: List.free
push_end       :: List.push_end
push_begin     :: List.push_begin
pop_end        :: List.pop_end
pop_begin      :: List.pop_begin
pop_end_opt    :: List.pop_end_opt
pop_begin_opt  :: List.pop_begin_opt
empty          :: List.empty
count          :: List.count
at             :: List.at
contains       :: List.contains
fold           :: List.fold
map            :: List.map
as_iter        :: List.as_iter
