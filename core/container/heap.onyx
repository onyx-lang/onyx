package core.heap

Heap :: struct (T: type_expr) {
    data: [..] T;
    compare: (T, T) -> i32 = null_proc;
}

builtin.Heap :: Heap

#overload
__make_overload :: macro (_: &Heap($T), allocator := context.allocator) -> Heap(T) {
    return Heap.make(T, allocator = allocator);
}

Heap.delete :: (h: &Heap) {
    Array.free(&h.data);
}

/// Drops every element and keeps the backing array.
Heap.clear :: (use h: &Heap) {
    Array.clear(&data);
}

/// Allocates a new heap with the same elements and comparison.
Heap.copy :: (h: &Heap, allocator := context.allocator) -> Heap(h.T) {
    out: Heap(h.T);
    out.compare = h.compare;
    out.data = Array.copy(&h.data, allocator);
    return out;
}

#overload
builtin.delete :: Heap.delete

Heap.make :: ($T: type_expr, cmp: (T, T) -> i32 = null_proc, allocator := context.allocator) -> Heap(T) {
    h: Heap(T);
    Heap.init(&h, cmp, allocator);
    return h;
}

Heap.init :: (use heap: &Heap, cmp: (heap.T, heap.T) -> i32 = null_proc, allocator := context.allocator) {
    Array.init(&data, allocator = allocator);
    compare = cmp;
}

Heap.insert :: (use heap: &Heap, v: heap.T) {
    data << v;
    shift_up(heap, data.count - 1);
}

#operator << macro (heap: Heap($T), v: T) {
    #this_package.Heap.insert(&heap, v);
}

Heap.empty :: macro (heap: &Heap) => heap.data.count == 0;

Heap.peek_top :: (use heap: &Heap) -> ? heap.T {
    if data.count == 0 do return .None;
    return data[0];
}

Heap.remove_top :: (use heap: &Heap) -> ? heap.T {
    if data.count == 0 do return .None;

    x := data[0];
    data->unordered_remove(0);
    shift_down(heap, 0);
    return x;
}

Heap.pop :: Heap.remove_top

Heap.remove :: macro (heap: &Heap, cond: Code) -> ? heap.T {
    shift_down :: shift_down

    for e, i in heap.data {
        if #unquote cond(e) {
            x := heap.data->unordered_remove(i);
            shift_down(heap, i);
            return x;
        }
    }

    return .None;
}


// These definitions only exist for backwards compatibility

make :: Heap.make
init :: Heap.init
insert :: Heap.insert
empty :: Heap.empty
peek_top :: Heap.peek_top
remove_top :: Heap.remove_top
pop :: Heap.pop
remove :: Heap.remove
delete :: Heap.delete
clear :: Heap.clear
copy :: Heap.copy


#local {
    heap_parent :: macro (index) => (index - 1) / 2
    heap_lchild :: macro (index) => (index * 2) + 1
    heap_rchild :: macro (index) => (index * 2) + 2

    shift_down :: (use heap: &Heap, idx: i32) {
        while true {
            min_index := idx;

            l := heap_lchild(idx);
            if l < data.count {
                if compare(data[l], data[min_index]) < 0 {
                    min_index = l;
                }
            }

            r := heap_rchild(idx);
            if r < data.count {
                if compare(data[r], data[min_index]) < 0 {
                    min_index = r;
                }
            }

            if idx != min_index {
                tmp := data[idx];
                data[idx] = data[min_index];
                data[min_index] = tmp;
                idx = min_index;
                continue;
            }

            break;
        }
    }

    shift_up :: (use heap: &Heap, idx: i32) {
        while idx > 0 {
            parent := heap_parent(idx);
            if compare(data[parent], data[idx]) <= 0 do break;

            tmp := data[parent];
            data[parent] = data[idx];
            data[idx] = tmp;
            idx = parent;
        }
    }
}

