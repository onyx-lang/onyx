package core.bucket_array

use core
use core.iter

/// Growable array stored as fixed-size buckets. Pointers into a bucket stay
/// valid until that bucket is freed (`clear` / `delete` / shrinking `pop`).
Bucket_Array :: struct (T: type_expr) {
    allocator: Allocator;
    elements_per_bucket: i32;
    count: i32;
    buckets: [..] Bucket(T);

    Bucket :: struct (T: type_expr) {
        count: i32;
        data: [&] T;
    }
}

builtin.Bucket_Array :: Bucket_Array

/// Creates an empty bucket array. `elements` is the size of each bucket.
Bucket_Array.make :: ($T: type_expr, elements: i32, allocator := context.allocator) -> Bucket_Array(T) {
    b: Bucket_Array(T);
    Bucket_Array.init(&b, elements, allocator);
    return b;
}

Bucket_Array.init :: (b: &Bucket_Array($T), elements: i32, allocator := context.allocator) {
    n := elements;
    if n < 1 do n = 1;

    b.allocator = allocator;
    b.elements_per_bucket = n;
    b.count = 0;
    Array.init(&b.buckets, 4, allocator);
    b.buckets << alloc_bucket(b);
}

#overload
__make_overload :: macro (_: &Bucket_Array($T), n: u32, allocator := context.allocator) -> Bucket_Array(T) {
    return Bucket_Array.make(T, n, allocator);
}

/// Frees every bucket. Prefer `delete(&b)`.
Bucket_Array.delete :: (b: &Bucket_Array) {
    for &bucket in b.buckets {
        if bucket.data != null {
            raw_free(b.allocator, bucket.data);
            bucket.data = null;
        }
        bucket.count = 0;
    }
    Array.free(&b.buckets);
    b.count = 0;
    b.elements_per_bucket = 0;
}

#overload
builtin.delete :: Bucket_Array.delete

/// Frees extra buckets and keeps one empty bucket so `push` can be used again.
Bucket_Array.clear :: (b: &Bucket_Array($T)) {
    if b.buckets.count == 0 {
        b.buckets << alloc_bucket(b);
        b.count = 0;
        return;
    }

    for i in 1 .. b.buckets.count {
        if b.buckets[i].data != null {
            raw_free(b.allocator, b.buckets[i].data);
            b.buckets[i].data = null;
        }
        b.buckets[i].count = 0;
    }

    b.buckets[0].count = 0;
    b.buckets.count = 1;
    b.count = 0;
}

/// Allocates a new bucket array with the same elements.
Bucket_Array.copy :: (b: &Bucket_Array($T), allocator := context.allocator) -> Bucket_Array(T) {
    out := Bucket_Array.make(T, b.elements_per_bucket, allocator);
    for i in b.count {
        Bucket_Array.push(&out, Bucket_Array.get(b, i));
    }
    return out;
}

Bucket_Array.empty :: (b: &Bucket_Array) -> bool {
    return b.count == 0;
}

Bucket_Array.get :: (b: &Bucket_Array($T), idx: i32) -> T {
    return *Bucket_Array.get_ptr(b, idx);
}

Bucket_Array.get_ptr :: (b: &Bucket_Array($T), idx: i32) -> &T {
    bucket_index := idx / b.elements_per_bucket;
    elem_index   := idx % b.elements_per_bucket;
    return &b.buckets[bucket_index].data[elem_index];
}

Bucket_Array.push :: (b: &Bucket_Array($T), elem: T) {
    if b.buckets.count == 0 {
        b.buckets << alloc_bucket(b);
    }

    last_bucket := &b.buckets[b.buckets.count - 1];
    if last_bucket.count >= b.elements_per_bucket {
        b.buckets << alloc_bucket(b);
        last_bucket = &b.buckets[b.buckets.count - 1];
    }

    last_bucket.data[last_bucket.count] = elem;
    last_bucket.count += 1;
    b.count += 1;
}

Bucket_Array.pop :: (b: &Bucket_Array($T)) -> ? T {
    if b.count == 0 do return .None;

    last_bucket := &b.buckets[b.buckets.count - 1];
    last_bucket.count -= 1;
    b.count -= 1;
    v := last_bucket.data[last_bucket.count];

    if last_bucket.count == 0 && b.buckets.count > 1 {
        raw_free(b.allocator, last_bucket.data);
        last_bucket.data = null;
        Array.pop(&b.buckets);
    }

    return v;
}

#operator [] macro (b: Bucket_Array($T), idx: i32) -> T {
    return #this_package.Bucket_Array.get(&b, idx);
}

#operator []= macro (b: Bucket_Array($T), idx: i32, value: T) {
    *#this_package.Bucket_Array.get_ptr(&b, idx) = value;
}

#operator &[] macro (b: Bucket_Array($T), idx: i32) -> &T {
    return #this_package.Bucket_Array.get_ptr(&b, idx);
}

#operator << macro (b: Bucket_Array($T), elem: T) {
    #this_package.Bucket_Array.push(&b, elem);
}

/// Gives a pointer to each element as `it`. `bucket_index` is the index inside the current bucket.
for_each :: macro (b: Bucket_Array($T), body: Code) {
    for &bucket in b.buckets {
        for bucket_index in bucket.count {
            it := &bucket.data[bucket_index];
            #unquote body(it);
        }
    }
}

#match iter.as_iter as_iter
as_iter :: (b: &Bucket_Array($T)) -> Iterator(T) {
    Context :: struct (T: type_expr) {
        ba         : &Bucket_Array(T);
        bucket_idx : i32;
        elem_idx   : i32;
    }

    next :: (use c: &Context($T)) -> ? T {
        if ba.buckets.count == 0 do return .None;

        bucket := &ba.buckets[bucket_idx];
        while elem_idx == bucket.count {
            bucket_idx += 1;
            if bucket_idx == ba.buckets.count do return .None;

            bucket = &ba.buckets[bucket_idx];
            elem_idx = 0;
        }

        defer elem_idx += 1;
        return bucket.data[elem_idx];
    }

    ctx := Context(T).{ ba = b };
    return iter.generator(&ctx, #solidify next { T=T });
}

#local
alloc_bucket :: (b: &Bucket_Array($T)) -> Bucket_Array.Bucket(T) {
    data := raw_alloc(b.allocator, sizeof T * b.elements_per_bucket);
    return .{ 0, data };
}

Bucket_Array.for_each :: for_each
Bucket_Array.as_iter  :: as_iter

make     :: Bucket_Array.make
init     :: Bucket_Array.init
delete   :: Bucket_Array.delete
clear    :: Bucket_Array.clear
copy     :: Bucket_Array.copy
empty    :: Bucket_Array.empty
get      :: Bucket_Array.get
get_ptr  :: Bucket_Array.get_ptr
push     :: Bucket_Array.push
pop      :: Bucket_Array.pop
