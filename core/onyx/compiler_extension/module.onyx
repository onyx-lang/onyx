package onyx.compiler_extension
#allow_stale_code

#load "../toolchain/compiler_events.proto.onyx"
#load "../toolchain/compilation_info.onyx"

use core {
    stdio
    Result
    eprintf
}
use core.alloc {package, arena}
use core.encoding.osad
use core.io
use protobuf.onyx.toolchain.events {*}
use onyx.toolchain { CompilationInfo }

// PROTOCOL VERSION 1
// 
// OUTGOING
//
// INIT (0)             send info about extension
//     version (u32)
//     name (str)
//
// REPORT (1)           report an error
//     position (Position)
//     msg (str)
//
// EXPANSION (2)        response to ExpandMacro
//     id (u32)
//     code (Result(str, Reason))
//
// INJECT (3)           add code to top level scope
//     code (str)
//
//
// INCOMING
//
// INIT (0)
//     version_major (u32)
//     version_minor (u32)
//     version_patch (u32)
//     max_protocol_version (u32)
//
// TERMINATE (1)
//
// EXPANDMACRO (2)
//     id (u32)
//     location (ExpansionLocation)
//     position (Position)
//     macro_name (str)
//     body (str)
//     scope_id (u32)     PROTOCOL 5: expansion-site scope for nearby lookup
//

// PROTOCOL VERSION 2 CHANGES
//
// OUTGOING INIT (0)
//     added `hooks ([] i32)` after `name`
//
// OUTGOING ACKNOWLEDGEHOOK (4)
//     Added
//
// INCOMING HOOK (3)
//     Added
//     1 = Stalled — no entity made progress. Remaining CompilationEvents
//         are flushed first so the extension can inject code that
//         defines missing names, then checking resumes.
//
// PROTOCOL VERSION 3 CHANGES
//
// INCOMING COMPILATIONEVENTS (4)
//     Added
//
// OUTGOING INIT hooks
//     2 = CompilationEvents (full event stream)
//     3 = reserved (formerly CompilationDataDetailed; treated as 2)
//     First dump after INIT includes the full history so far.
//
// PROTOCOL VERSION 4 CHANGES
//
// INCOMING HOOK (3)
//     4 = All_Code_Checked
//     Synchronous barrier after all parse/check work and before code
//     generation. Remaining CompilationEvents are flushed first so
//     CompilationInfo is complete. InjectCode is applied and compiled
//     before generation; the hook may fire again if inject added work.
//
// PROTOCOL VERSION 5 CHANGES
//
// INCOMING EXPANDMACRO (2)
//     added `scope_id (u32)` after `body`
//     Scope of the expansion entity, so the extension can look up
//     nearby symbols (CompilationInfo.lookup) once types are ready.


// Types

IncomingMessage :: union {
    Init as 0: struct {
        compiler_version_major: u32
        compiler_version_minor: u32
        compiler_version_patch: u32

        max_protocol_version_supported: u32
    }

    Terminate as 1: struct {
    }

    ExpandMacro as 2: ExpansionInfo

    Hook as 3: struct {
        id: u32
        info: HookInfo
    }

    CompilationEvents as 4: struct {
        events: [] u8
    }
}

OutgoingMessage :: union {
    Init as 0: struct {
        protocol_version: u32
        name: str

        hooks: [] i32
    }

    ErrorReport as 1: struct {
        position: Position
        msg: str
    }

    Expansion as 2: struct {
        id: u32
        code: Result(str, ExpansionFailureReason)
    }

    InjectCode as 3: struct {
        code: str
    }

    AcknowledgeHook as 4: struct {
        id: u32
    }
}

ExpansionInfo :: struct {
    id: u32
    location: ExpansionLocation
    position: Position
    macro_name: str
    body: str
    scope_id: u32
}

ExpansionLocation :: enum {
    Expression
    Statement
    TopLevelStatement
}

ExpansionFailureReason :: enum {
    NotSupported
    BadSyntax
}

Position :: struct {
    filename: str
    line: u32
    column: u32
    length: u32
}

HookInfo :: union {
    None as 0: struct {}

    Stalled as 1: struct {}

    CompilationEvents as 2: struct {}

    All_Code_Checked as 4: struct {}

    Count as 5: struct {}
}


// Code

ExtensionContext :: struct {
    protocol_version: u32
    name: str
    proc_macros: Map(str, #type (&ExtensionContext, ExpansionInfo) -> Result(str, ExpansionFailureReason))
    hook_handlers: [cast(i32) HookInfo.tag_enum.Count] (&ExtensionContext, HookInfo) -> void

    arena: arena.Arena

    reader: io.Reader

    running: bool
    wants_compilation_events: bool
    compiler_events: CompilerEvents
    compilation_info: CompilationInfo
}

ExtensionContext.make :: (name: str) -> (res: ExtensionContext) {
    res.name = name
    res.protocol_version = 3

    res.proc_macros = make(typeof res.proc_macros)
    res.compiler_events.events = make(typeof res.compiler_events.events)
    res.compilation_info = CompilationInfo.make()
    res.arena = arena.make(context.allocator, 32 * 1024)
    res.reader = io.Reader.make(&stdio.stream, 256 * 1024)
    return
}

ExtensionContext.start :: (self: &#Self, callback: (&#Self, msg: IncomingMessage) -> void) {
    self.running = true

    while self.running {
        msg: IncomingMessage
        if !osad.deserialize(&msg, typeof msg, &self.reader, alloc.as_allocator(&self.arena)) {
            break
        }

        switch msg {
            case .Init as &init {
                use hooks := make([..] i32)
                for h, i in self.hook_handlers {
                    if h != null_proc {
                        hooks->push(i)
                    }
                }

                if self.wants_compilation_events {
                    found := false
                    for h in hooks {
                        if h == 2 do found = true
                    }
                    if !found do hooks->push(2)
                }

                self->send(.{
                    Init = .{
                        protocol_version = self.protocol_version
                        name = self.name
                        hooks = hooks
                    }
                })
            }

            case .Terminate do break break

            case .Hook as &hk {
                handler := self.hook_handlers[~~~ hk.info.tag]

                if handler != null_proc {
                    handler(self, hk.info)
                }

                self->send(.{
                    AcknowledgeHook = .{
                        id = hk.id
                    }
                })
            }

            case .CompilationEvents as &ce {
                switch self.compilation_info->ingest_protobuf(ce.events) {
                    case .Ok {}
                    case .Err as err {
                        eprintf("Failed to unmarshal CompilationEvents: {p}\n", err)
                    }
                }

                callback(self, msg)
            }

            case .ExpandMacro as em {
                if self.proc_macros->has(em.macro_name) {
                    handler := self.proc_macros->get(em.macro_name)->unwrap()
                    result  := handler(self, em)
                    self->send(.{
                        Expansion = .{
                            id = em.id,
                            code = result
                        }
                    })

                } else {
                    fallthrough
                }
            }

            case _ {
                callback(self, msg)
            }
        }

        alloc.arena.clear(&self.arena)
    }
}

ExtensionContext.send :: (self: &#Self, msg: OutgoingMessage) {
    use stdout_writer := io.Writer.make(&stdio.stream)

    osad.serialize(msg, &stdout_writer)
}

ExtensionContext.handle_macro :: (self: &#Self, name: str, func: (&ExtensionContext, ExpansionInfo) -> Result(str, ExpansionFailureReason)) {
    self.proc_macros->put(name, func)
}

ExtensionContext.handle_hook :: (self: &#Self, hook: HookInfo.tag_enum, func: (&ExtensionContext, HookInfo) -> void) {
    self.hook_handlers[~~hook] = func
    if hook == .All_Code_Checked {
        if self.protocol_version < 4 do self.protocol_version = 4
    }
}

ExtensionContext.enable_compilation_events :: (self: &#Self) {
    if self.protocol_version < 3 do self.protocol_version = 3
    self.wants_compilation_events = true
}



map_position :: (base_pos: Position, pos: Position) => {
    line := do {
        if pos.line == 1 do return base_pos.line;
        return pos.line + base_pos.line - 1;
    };

    column := do {
        if pos.line == 1 do return base_pos.column + pos.column - 1;
        return pos.column;
    };

    return Position.{
        filename = base_pos.filename,
        line = line,
        column = column,
        length = pos.length
    };
}

