use core {*}
use core.encoding.json

// @leak-check

Person :: struct {
    name: str;
    age: i32;
}

Color :: enum {
    Red;
    Blue;
}

main :: () {
    j := json.decode("{\"a\": 1}")!;
    defer delete(j);
    println(j.root["a"]->as_int());

    p := json.decode_as("{\"name\": \"Ada\", \"age\": 36}", Person)!;
    defer str.free(p.name);
    println(p.name);
    println(p.age);

    p2 := json.decode_as(j.root, struct { a: i32 })!;
    println(p2.a);

    s := json.encode_string(p)!;
    defer str.free(s);
    println(s);

    pretty := json.encode_string(.{ x = 1, y = 2 }, indent=2)!;
    defer str.free(pretty);
    println(pretty);

    err := json.decode_as("\"nope\"", i32).Err ?? .{};
    println(err.kind);
    println(err.expected);
    println(err.actual);

    err2 := json.decode("{").Err ?? .{};
    println(err2.kind != .None);
    println(json.valid("{\"a\":1}"));
    println(json.valid("{"));

    Opt :: struct { n: ? i32 };
    o := json.decode_as("{\"n\": null}", Opt)!;
    println(o.n == .None);

    nested := json.decode_as("{\"p\": {\"name\": 1}}", struct { p: Person }).Err ?? .{};
    println(nested.kind);
    println(nested.path);

    c := json.decode_as("\"Blue\"", Color)!;
    println(c == Color.Blue);

    println(json.valid(""));
    println(json.valid("1 2"));
    println(json.valid("  1  "));

    m := json.decode_as("{\"a\": 1, \"b\": 2}", Map(str, i32))!;
    defer {
        for e in m.entries {
            str.free(e.key);
        }
        delete(&m);
    }
    println(m->get("a") ?? -1);
    println(m->get("b") ?? -1);

    mt := json.from_any(&m);
    defer json.free(mt, context.allocator);
    println(mt["a"]->as_int());

    lines := json.decode_jsonl("1\n2\n\n3\n", i32)!;
    defer delete(&lines);
    println(lines.count);
    println(lines[0]);
    println(lines[2]);

    v := json.from_any(.{ name = "x", age = 1 });
    defer json.free(v, context.allocator);
    json.encode(&stdio.print_writer, v);
    println("");

    reader, rstream := io.reader_from_string("[1,2,3]");
    defer {
        delete(&reader);
        cfree(rstream);
    }
    use dec := json.Decoder.make(&reader);
    arr := dec->decode()!;
    defer delete(arr);
    println(arr.root[0]->as_int());
    println(arr.root[2]->as_int());
    println(dec->more());

    reader2, rstream2 := io.reader_from_string("1\n2\n\n3");
    defer {
        delete(&reader2);
        cfree(rstream2);
    }
    use dec2 := json.Decoder.make(&reader2);
    n := 0;
    sum := 0;
    while dec2->more() {
        x := dec2->decode_as(i32)!;
        n += 1;
        sum += x;
    }
    println(n);
    println(sum);

    estream := io.buffer_stream_make(64);
    ewriter := io.writer_make(&estream, 0);
    defer io.buffer_stream_free(&estream);
    enc := json.Encoder.make(&ewriter, newline=true);
    enc->encode(1);
    enc->encode(2);
    io.writer_flush(&ewriter);
    println(io.buffer_stream_to_str(&estream));
    delete(&ewriter);

    buf := make([] u8, 1);
    buf[0] = 0;
    nul := json.encode_string(cast(str) buf)!;
    defer str.free(nul);
    println(nul);
    vt := json.encode_string("\v")!;
    defer str.free(vt);
    println(vt);
}
