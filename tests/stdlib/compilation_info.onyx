#load "core:onyx/toolchain/module"

use core {*}
use onyx.toolchain {*}
use protobuf.onyx.toolchain.events

ok :: (label: str, value: bool) {
    println(label)
    println(value)
}

main :: () {
    b := Builder.make();
    defer b->destroy();

    core_root := os.env("ONYX_PATH") ?? "";
    defer str.free(core_root);
    b->map_dir("core", tprintf("{}/core", core_root));

    b->enable(.DISABLE_EXTENSIONS);
    b->enable(.MULTI_THREADING);
    b->enable(.COMPILATION_DATA_DETAILED);
    b->set_platform(.ONYX);

    b->inject_source("""
package foo.bar

Point :: struct {
    x: i32
    y: i32
}

Shape :: union {
    Point: Point
    Empty: void
}

x :: 1
y :: x

Color :: enum {
    Red
    Green :: 10
    Blue
}

origin :: Point.{ x = x, y = 0 }

get_x :: (p: Point) -> i32 {
    return p.x
}

Point.mag :: (p: Point) -> i32 {
    return p.x
}

Names :: #type [] u8
Names.has_a :: (s: Names) -> bool {
    return true
}

Ptr :: &Point
Arr :: [2] i32
""");

    b->inject_source("""
package main

use foo.bar { Point, get_x, x, Shape }

main :: () {
    p := Point.{ x = x, y = 0 }
    _ := get_x(p)
    s := Shape.{ Point = p }
    _ := s.Point
}
""");
    b->compile();

    ok("compile_ok", !b->has_errors());

    info := b->compilation_info();
    defer delete(&info);

    ok("has_version", info.compiler_version.count > 0);

    foo := info->package_named("foo");
    foo_bar := info->package_named("foo.bar");
    parent_ok := false;
    if foo as f {
        if foo_bar as fb do parent_ok = fb.parent_package_id == f.id;
    }
    ok("package_parent", parent_ok);

    point_sym: &SymbolInfo = null;
    for id in info->symbols_named("Point") {
        if info->get_symbol(id) as sym {
            if point_sym == null && sym.kind == .Struct do point_sym = sym;
        }
    }
    ok("point_symbol", point_sym != null);

    pkg_scope_ok := false;
    if foo_bar as fb {
        if point_sym != null && fb.scope_id != 0 {
            pkg_scope_ok = point_sym.scope_id == fb.scope_id;
        }
    }
    ok("point_in_package_scope", pkg_scope_ok);

    point_type: &TypeInfo = null;
    for id in info->types_named("Point") {
        if info->get_type(id) as t {
            if t.kind == .Struct do point_type = t;
        }
    }
    ok("point_type", point_type != null);

    has_x := false;
    has_y := false;
    member_x_sym: u32;
    if point_type != null {
        if info->member(point_type.id, "x") as m {
            has_x = true;
            member_x_sym = m.symbol_id;
        }
        if info->member(point_type.id, "y") do has_y = true;
    }
    ok("point_members", has_x && has_y);

    point_type_of := false;
    if point_sym != null {
        if info->type_of(point_sym.id) as t do point_type_of = point_type != null && t.id == point_type.id;
    }
    ok("point_type_of", point_type_of);

    point_symbols_with_type := false;
    if point_type != null && point_sym != null {
        for id in info->symbols_with_type(point_type.id) {
            if id == point_sym.id do point_symbols_with_type = true;
        }
    }
    ok("point_symbols_with_type", point_symbols_with_type);

    point_binding := false;
    point_binding_loc := false;
    if point_type != null {
        if info->binding_of(point_type.id) as sym {
            point_binding = point_sym != null && sym.id == point_sym.id;
            if sym.file_id != 0 && sym.line != 0 {
                if info->get_file(sym.file_id) do point_binding_loc = true;
            }
        }
    }
    ok("point_binding_of", point_binding);
    ok("point_binding_location", point_binding_loc);

    x_in_scope := false;
    if point_type != null {
        if info->lookup_member(point_type.id, "x") as sym do x_in_scope = sym.kind == .Member;
    }
    ok("lookup_member_x", x_in_scope);

    color_ok := false;
    for id in info->types_named("Color") {
        if info->get_type(id) as t {
            if t.kind != .Enum do continue;
            switch t.body {
                case .Enumeration as en {
                    has_red := false
                    has_green := false
                    has_blue := false
                    for v in en.values {
                        if v.name == "Red" && v.value == 0 do has_red = true
                        if v.name == "Green" && v.value == 10 do has_green = true
                        if v.name == "Blue" && v.value == 11 do has_blue = true
                    }
                    color_ok = has_red && has_green && has_blue
                }
                case _ {}
            }
        }
    }
    ok("color_enum", color_ok);

    shape_ok := false;
    for id in info->types_named("Shape") {
        if info->get_type(id) as t {
            if info->variant(t.id, "Point") do shape_ok = true;
        }
    }
    ok("shape_variant", shape_ok);

    ptr_elem_ok := false;
    for id in info->types_named("&i32") {
        if info->elem(id) as e {
            if e.name == "i32" && e.kind == .Basic do ptr_elem_ok = true;
        }
    }
    ok("ptr_elem", ptr_elem_ok);

    resolved_member := false;
    if member_x_sym != 0 {
        for r in info->references(member_x_sym) {
            if r.length != 0 do resolved_member = true;
        }
    }
    ok("resolved_member_x", resolved_member);

    get_x_ok := false;
    for id in info->symbols_named("get_x") {
        if info->get_symbol(id) as sym {
            if sym.kind == .Function do get_x_ok = true;
        }
    }
    ok("get_x_function", get_x_ok);

    get_x_sym: &SymbolInfo = null;
    for id in info->symbols_named("get_x") {
        if info->get_symbol(id) as sym {
            if get_x_sym == null && sym.kind == .Function do get_x_sym = sym;
        }
    }

    param_p_ok := false;
    param_p_type_ok := false;
    param_p_use_ok := false;
    get_x_param_ids_ok := false;
    if get_x_sym != null && get_x_sym.param_symbol_ids.count == 1 {
        if info->get_symbol(get_x_sym.param_symbol_ids[0]) as p {
            param_p_ok = p.name == "p" && p.kind == .Parameter;
            if point_type != null {
                if info->type_of(p.id) as t do param_p_type_ok = t.id == point_type.id;
            }
            for r in info->references(p.id) {
                if r.length != 0 do param_p_use_ok = true;
            }
        }

        if info->type_of(get_x_sym.id) as t {
            switch t.body {
                case .Function as f {
                    get_x_param_ids_ok = f.param_ids.count == 1 && point_type != null && f.param_ids[0] == point_type.id;
                }
                case _ {}
            }
        }
    }
    ok("param_p_symbol", param_p_ok);
    ok("param_p_type", param_p_type_ok);
    ok("param_p_use", param_p_use_ok);
    ok("get_x_param_type_ids", get_x_param_ids_ok);

    point_method_ok := false;
    if point_type != null && point_type.scope_id != 0 {
        for sid in info->symbols_in_scope(point_type.scope_id) {
            if info->get_symbol(sid) as sym {
                if sym.name == "mag" {
                    switch sym.kind {
                        case .Function, .Overloaded_Function, .Polymorphic_Proc do point_method_ok = true;
                        case _ {}
                    }
                }
            }
        }
    }
    ok("point_method_mag", point_method_ok);

    names_type_ok := false;
    names_method_ok := false;
    slice_scope_ok := false;
    for id in info->symbols_named("Names") {
        if info->get_symbol(id) as sym {
            if info->type_of(sym.id) as t {
                names_type_ok = t.kind == .Slice;
                slice_scope_ok = t.scope_id != 0;
                if t.scope_id != 0 {
                    for sid in info->symbols_in_scope(t.scope_id) {
                        if info->get_symbol(sid) as m {
                            if m.name == "has_a" do names_method_ok = true;
                        }
                    }
                }
            }
        }
    }
    ok("names_alias_is_slice", names_type_ok);
    ok("names_slice_has_scope", slice_scope_ok);
    ok("names_method_has_a", names_method_ok);

    first_applied := info.events_applied;

    b->inject_source("package extra\nextra_y :: 1\n");
    b->compile();
    added := b->update_compilation_info(&info);

    still_foo := false;
    if info->package_named("foo.bar") do still_foo = true;

    got_extra := false;
    if info->package_named("extra") do got_extra = true;

    extra_sym := false;
    for id in info->symbols_named("extra_y") {
        extra_sym = true;
    }

    ok("stream_added_events", added > 0);
    ok("stream_kept_foo", still_foo);
    ok("stream_got_extra", got_extra);
    ok("stream_got_extra_y", extra_sym);
    ok("stream_applied_grew", info.events_applied > first_applied);

    errb := Builder.make();
    defer errb->destroy();
    errb->map_dir("core", tprintf("{}/core", core_root));
    errb->enable(.DISABLE_EXTENSIONS);
    errb->enable(.MULTI_THREADING);
    errb->enable(.COMPILATION_DATA_DETAILED);
    errb->set_platform(.ONYX);
    errb->inject_source("""
package erridx

broken :: () {
    x: i32 = "nope"
}

later :: () -> i32 {
    return 1
}
""");
    errb->compile();

    ok("error_compile_has_errors", errb->has_errors());

    errinfo := errb->compilation_info();
    defer delete(&errinfo);

    later_ok := false;
    for id in errinfo->symbols_named("later") {
        if errinfo->get_symbol(id) as sym {
            if sym.kind == .Function {
                if errinfo->type_of(sym.id) do later_ok = true;
            }
        }
    }

    broken_named := false;
    for id in errinfo->symbols_named("broken") {
        broken_named = true;
    }

    ok("error_keeps_later", later_ok);
    ok("error_keeps_broken_name", broken_named);

    // Method field + #match option + alias of the field, like os.File.get_contents.
    matchb := Builder.make();
    defer matchb->destroy();
    matchb->map_dir("core", tprintf("{}/core", core_root));
    matchb->enable(.DISABLE_EXTENSIONS);
    matchb->enable(.MULTI_THREADING);
    matchb->enable(.COMPILATION_DATA_DETAILED);
    matchb->set_platform(.ONYX);
    matchb->inject_source("""
package main

Holder :: struct {}
Holder.get :: (h: &Holder) -> i32 { return 1 }

get :: #match {
    Holder.get,
    (x: i32) -> i32 { return x }
}

get_from_holder :: Holder.get

main :: () {
    _ := get_from_holder
}
""");
    matchb->compile();

    ok("method_match_alias_ok", !matchb->has_errors());

    matchinfo := matchb->compilation_info();
    defer delete(&matchinfo);

    get_from_named := false;
    for id in matchinfo->symbols_named("get_from_holder") {
        get_from_named = true;
    }
    ok("method_match_alias_indexed", get_from_named);

    circb := Builder.make();
    defer circb->destroy();
    circb->map_dir("core", tprintf("{}/core", core_root));
    circb->enable(.DISABLE_EXTENSIONS);
    circb->enable(.MULTI_THREADING);
    circb->enable(.COMPILATION_DATA_DETAILED);
    circb->set_platform(.ONYX);
    circb->inject_source("""
package main

a :: b
b :: a

main :: () {
}
""");
    circb->compile();

    circinfo := circb->compilation_info();
    defer delete(&circinfo);

    ok("circular_alias_has_errors", circb->has_errors());
    ok("circular_alias_finished", circinfo.events_applied > 0);

    missb := Builder.make();
    defer missb->destroy();
    missb->map_dir("core", tprintf("{}/core", core_root));
    missb->enable(.DISABLE_EXTENSIONS);
    missb->enable(.MULTI_THREADING);
    missb->enable(.COMPILATION_DATA_DETAILED);
    missb->set_platform(.ONYX);
    missb->inject_source("""
package main

use core {*}
use core.iter {as_iter}

main :: () {
    xs := i32.[1, 2, 3]
    _ := as_iter(xs)
        |> .map(x => Missing.foo(x))
        |> .collect()
}
""");
    missb->compile();

    missinfo := missb->compilation_info();
    defer delete(&missinfo);

    ok("unresolved_in_poly_has_errors", missb->has_errors());
    ok("unresolved_in_poly_finished", missinfo.events_applied > 0);

    pathb := Builder.make();
    defer pathb->destroy();
    pathb->map_dir("core", tprintf("{}/core", core_root));
    pathb->enable(.DISABLE_EXTENSIONS);
    pathb->enable(.MULTI_THREADING);
    pathb->enable(.COMPILATION_DATA_DETAILED);
    pathb->set_platform(.ONYX);
    pathb->inject_source("""
package foo.bar

Point :: struct {
    x: i32
    y: i32
}
""");
    pathb->inject_source("""
package main

use foo {package}
use core {*}

main :: () {
    p := foo.bar.Point.{ x = 1, y = 2 }
    _ := p.x
    opt := Optional.empty(foo.bar.Point)
    if opt as s {
        _ := s.x
    }
    a, b := p, p
    _ := a.x
    _ := b.x
}

named_out :: () -> (out: foo.bar.Point) {
    out.x = 1
    return
}
""");
    pathb->compile();

    ok("nested_path_compile_ok", !pathb->has_errors());

    pathinfo := pathb->compilation_info();
    defer delete(&pathinfo);

    start_scope: u32 = 0;
    for id in pathinfo->symbols_named("p") {
        if pathinfo->get_symbol(id) as psym {
            if pathinfo->lookup(psym.scope_id, "foo") {
                start_scope = psym.scope_id;
            }
        }
    }

    foo_bar_path := false;
    point_in_bar := false;
    lookup_no_parent := false;
    if start_scope != 0 {
        switch pathinfo->resolve_path(start_scope, str.["foo", "bar"]) {
            case .Pkg as pkg {
                foo_bar_path = pkg.fully_qualified_name == "foo.bar";
                if pathinfo->lookup_in_scope(pkg.scope_id, "Point") as ps {
                    if ps.kind == .Struct do point_in_bar = true;
                }
                lookup_no_parent = true;
                if pathinfo->lookup_in_scope(pkg.scope_id, "foo") do lookup_no_parent = false;
            }
            case _ {}
        }
    }
    ok("foo_bar_path", foo_bar_path);
    ok("point_in_nested_package", point_in_bar);
    ok("lookup_in_scope_no_parent", lookup_no_parent);

    alloc_pkg_id := false;
    alloc_arena_path := false;
    if start_scope != 0 {
        if pathinfo->lookup(start_scope, "alloc") as alloc_sym {
            if pathinfo->package_of(alloc_sym) as ap {
                if pathinfo->package_named("core.alloc") as expected {
                    alloc_pkg_id = ap.id == expected.id;
                }
            }
        }
        switch pathinfo->resolve_path(start_scope, str.["alloc", "arena"]) {
            case .Pkg as pkg {
                alloc_arena_path = pkg.fully_qualified_name == "core.alloc.arena";
            }
            case _ {}
        }
    }
    ok("alloc_package_id", alloc_pkg_id);
    ok("alloc_arena_path", alloc_arena_path);

    value_chain := false;
    p_is_value := false;
    point_is_type := false;
    if start_scope != 0 {
        switch pathinfo->resolve_path(start_scope, str.["p", "x"]) {
            case .Value as t {
                if t.kind == .Basic do value_chain = true;
            }
            case _ {}
        }
        switch pathinfo->resolve_path(start_scope, str.["p"]) {
            case .Value do p_is_value = true;
            case _ {}
        }
        switch pathinfo->resolve_path(start_scope, str.["foo", "bar", "Point"]) {
            case .Type do point_is_type = true;
            case _ {}
        }
    }
    ok("value_member_path", value_chain);
    ok("p_is_value", p_is_value);
    ok("point_is_type_name", point_is_type);

    as_binding_typed := false;
    for id in pathinfo->symbols_named("s") {
        if pathinfo->get_symbol(id) as ssym {
            if pathinfo->type_of(ssym.id) as t {
                if pathinfo->member(t.id, "x") do as_binding_typed = true;
            }
        }
    }
    ok("as_binding_typed", as_binding_typed);

    compound_a_typed := false;
    compound_b_typed := false;
    for id in pathinfo->symbols_named("a") {
        if pathinfo->get_symbol(id) as asym {
            if pathinfo->type_of(asym.id) as t {
                if pathinfo->member(t.id, "x") do compound_a_typed = true;
            }
        }
    }
    for id in pathinfo->symbols_named("b") {
        if pathinfo->get_symbol(id) as bsym {
            if pathinfo->type_of(bsym.id) as t {
                if pathinfo->member(t.id, "x") do compound_b_typed = true;
            }
        }
    }
    ok("compound_a_typed", compound_a_typed);
    ok("compound_b_typed", compound_b_typed);

    named_out_typed := false;
    named_out_in_body := false;
    for id in pathinfo->symbols_named("out") {
        if pathinfo->get_symbol(id) as osym {
            if pathinfo->type_of(osym.id) as t {
                if pathinfo->member(t.id, "x") do named_out_typed = true;
            }
            for r in pathinfo->references(osym.id) {
                if r.line == osym.line && r.column == osym.column do continue;
                sid := pathinfo->scope_at(r.file_id, r.line, r.column);
                if pathinfo->lookup(sid, "out") as found {
                    if pathinfo->type_of(found.id) as t {
                        if pathinfo->member(t.id, "x") do named_out_in_body = true;
                    }
                }
            }
        }
    }
    ok("named_out_typed", named_out_typed);
    ok("named_out_in_body", named_out_in_body);

    ifb := Builder.make();
    defer ifb->destroy();
    ifb->map_dir("core", tprintf("{}/core", core_root));
    ifb->enable(.DISABLE_EXTENSIONS);
    ifb->enable(.MULTI_THREADING);
    ifb->enable(.COMPILATION_DATA_DETAILED);
    ifb->set_platform(.ONYX);
    ifb->inject_source("""
package main

main :: () {
    app := .{ test = 10 }
    #if false {
        skip := (c) => {
            return c
        }
        _ := skip
    }
    _ := app.test
}
""");
    ifb->compile();

    ok("static_if_compile_ok", !ifb->has_errors());

    ifinfo := ifb->compilation_info();
    defer delete(&ifinfo);

    app_sym: &SymbolInfo = null;
    for id in ifinfo->symbols_named("app") {
        if ifinfo->get_symbol(id) as sym {
            if app_sym == null && sym.kind == .Expression do app_sym = sym;
        }
    }

    after_if_lookup := false;
    after_if_member := false;
    if app_sym != null {
        for r in ifinfo->references(app_sym.id) {
            if r.line == app_sym.line && r.column == app_sym.column do continue;
            sid := ifinfo->scope_at(r.file_id, r.line, r.column);
            if ifinfo->lookup(sid, "app") as found {
                if found.id == app_sym.id do after_if_lookup = true;
                if ifinfo->member(found.type_id, "test") do after_if_member = true;
            }
        }
    }
    ok("static_if_keeps_outer_local", after_if_lookup);
    ok("static_if_completes_member", after_if_member);
}
