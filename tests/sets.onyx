

use core {*}

main :: (args: [] cstr) {

    S := set.Set.make(i32);

    set.Set.insert(&S, 5);
    set.Set.insert(&S, 5);
    set.Set.insert(&S, 6);
    for entry in S.entries do println(entry.value);

    println(set.Set.has(&S, 5));

    println("--------------");
    set.Set.remove(&S, 5);
    for entry in S.entries do println(entry.value);
    println(set.Set.has(&S, 5));
}