package main



use core {*}

main :: (args: [] cstr) {
    imap : Map(i32, str);
    map.Map.init(&imap);
    defer {
        print("Freeing map\n");
        map.Map.free(&imap);
    }
    map.Map.put(&imap, 50, "Hello ");
    imap->put(1234, "World!");

    println(map.Map.has(&imap, 50));
    println(map.Map.has(&imap, 51));

    printf("{}{}\n", map.Map.get(&imap, 50)->unwrap(), map.Map.get(&imap, 1234)->unwrap());

    printf("{*p}\n", &imap);

    map.Map.remove(&imap, 50);
    println(map.Map.has(&imap, 50));

    map.Map.clear(&imap);
    println(map.Map.has(&imap, 1234));
}
