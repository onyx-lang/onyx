PART :: 2

use core {*}

main :: (args) => {
    use file := os.File.open("tests/aoc-2021/input/day02.txt")->unwrap();
    use reader := io.Reader.make(&file);

    #if PART == 1 {
        horizontal, vertical := 0, 0;
        while !io.Reader.empty(&reader) {
            parts := str.split(io.Reader.read_line(&reader, inplace=true), ' ');
            defer memory.free_slice(&parts);

            value := cast(i32) conv.parse_int(parts[1]);
            switch parts[0] {
                case "forward" do horizontal += value;
                case "down"    do vertical += value;
                case "up"      do vertical -= value;
            }
        }

        printf("Part 1: {}\n", horizontal * vertical);
    }

    #if PART == 2 {
        horizontal, vertical, aim : i64;
        horizontal, vertical, aim = 0, 0, 0;
        while !io.Reader.empty(&reader) {
            parts := str.split(io.Reader.read_line(&reader, inplace=true), ' ');
            defer memory.free_slice(&parts);

            value := conv.parse_int(parts[1]);
            switch parts[0] {
                case "forward" { 
                    horizontal += value;
                    vertical += aim * value;
                }
                case "down"    do aim += value;
                case "up"      do aim -= value;
            }
        }

        printf("Part 2: {}\n", horizontal * vertical);
    }
}
