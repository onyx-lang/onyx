

use core {*}

main :: (args) => {
    use file := os.File.open("./tests/aoc-2021/input/day06.txt")->unwrap();
    use reader := io.Reader.make(&file);
    start_str := io.Reader.read_all(&reader);

    start_list := str.split(start_str, ',');

    fish: [9] i64;
    for start_list {
        value := cast(i32) conv.parse_int(it);
        fish[value] += 1;
    }

    for day in 256 {
        new_fish := fish[0];
        for 8 do fish[it] = fish[it + 1];
        fish[6] += new_fish;
        fish[8] = new_fish;
    }

    total := Slice.sum(fish);
    printf("Part 2: {}\n", total);
}
