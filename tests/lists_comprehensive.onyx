use core {*}

// @leak-check

main :: () {
    l := make(list.List(i32));

    for 10 {
        list.List.push_end(&l, it);
    }

    for iter.as_iter(&l) {
        println(it);
    }

    println("=================");
    for 5 {
        list.List.pop_begin_opt(&l) |> println();
    }

    println("=================");
    for iter.as_iter(&l) {
        println(it);
    }

    println("=================");
    for 5 {
        list.List.pop_end_opt(&l) |> println();
    }

    println("=================");
    for 5 {
        list.List.pop_begin_opt(&l) |> println();
    }

    println(list.List.count(&l));
    println(list.List.empty(&l));
    delete(&l);
}
