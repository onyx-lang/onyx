

use core
use core.io
use core {println}

main :: (args: [] cstr) {
    some_string := "This is a test string that can be read.\n\n\n\n\n\n1234 4567";

    sstream := io.BufferStream.make(some_string);
    sreader := io.Reader.make(&sstream);

    for i in 0 .. 2 {
        word := io.Reader.read_word(&sreader, allocator=context.temp_allocator);
        println(word);
    }

    println(io.Reader.read_line(&sreader, consume_newline=false, allocator=context.temp_allocator));

    a := io.Reader.read_u32(&sreader);
    b := io.Reader.read_u32(&sreader);

    println(a);
    println(b);
    println(a + b);
}
